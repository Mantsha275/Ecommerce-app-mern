# Base URL of the ShopX backend API. Leave unset (or empty) for same-origin
# deployments. Set this explicitly when frontend and backend are deployed to
# different domains (e.g. Vercel split deployment).
#
# No trailing slash. Example values:
#   REACT_APP_API_URL=http://localhost:4000
#   REACT_APP_API_URL=https://shopx-api.example.com
REACT_APP_API_URL=
