# ShopX backend environment variables.
# Copy this file to `.env` for local development. On Vercel, set each of
# these in Project Settings -> Environment Variables instead (do not commit
# a real .env file).
#
# Every variable below was found by grepping the backend source for
# `process.env.*` - nothing here is guessed or aspirational.

# ---- Server ----
# Port for local/traditional hosting only. Ignored on Vercel (the platform
# invokes the exported `app` directly - see index.js).
PORT=5000

# development | production. Affects error-handler verbosity (stack traces)
# via middleware/error.js.
NODE_ENV=development

# Comma-separated list of allowed CORS origins (credentials: true, so this
# cannot be "*"). Must exactly match the frontend's deployed origin(s),
# including protocol, with no trailing slash.
#   Local:    CLIENT_URL=http://localhost:3000
#   Split deploy: CLIENT_URL=https://shopx.example.com
CLIENT_URL=http://localhost:3000

# Set to "false" ONLY when the frontend is deployed as its OWN separate
# Vercel project (split deploy) and this backend should not try to serve
# client/build (which won't exist in that deployment). Leave unset/"true"
# for traditional hosting where this server also serves the React build.
SERVE_CLIENT_BUILD=true

# ---- Database ----
# Either name works (config/database.js checks DB_URI first, falls back to
# MONGODB_URI) - set ONE of these, not both.
DB_URI=mongodb+srv://<user>:<password>@<cluster>/<db-name>
# MONGODB_URI=

# ---- Auth ----
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_TIME=7d
# Cookie lifetime in DAYS (consumed as a number by jwtToken.js).
COOKIE_EXPIRES_TIME=7

# ---- Cloudinary (product images + user avatars) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Stripe ----
# Secret key - used server-side only (controller/paymentController.js).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Publishable key - handed to the frontend via GET /api/v1/stripeapikey.
# Safe to expose to the client; still set here rather than hardcoded.
STRIPE_API_KEY=pk_test_xxxxxxxxxxxx

# ---- Outgoing email (password reset) - utils/sendEmail.js ----
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ShopX
